# Copy to .env (for spike/) or .dev.vars (for `npm run dev`). Both are git-ignored. Never commit them.

# --- Worker (npm run dev) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
COOKIE_ENCRYPTION_KEY=
# Your LinkedIn member ID (the sign-in page shows it)
ALLOWED_MEMBER_IDS=

# --- Spike script ---

# From LinkedIn Developer Portal → Tools → OAuth Token Generator
# Scopes: openid profile w_member_social
LINKEDIN_ACCESS_TOKEN=

# LinkedIn REST API version, YYYYMM. LinkedIn retires versions after about a year;
# if the spike reports a version error, set this to a recent month.
LINKEDIN_VERSION=202609
